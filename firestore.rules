rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'id', 'mode', 'durationMinutes', 'timestamp'])
        && (data.keys().hasOnly(['userId', 'id', 'mode', 'durationMinutes', 'timestamp', 'topic']))
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.mode is string && data.mode in ['pomodoro', 'shortBreak', 'longBreak']
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440
        && data.timestamp is number
        && (!data.keys().hasAny(['topic']) || (data.topic is string && data.topic.size() <= 200));
    }

    match /users/{userId}/sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId;
      allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow create: if isSignedIn()
                    && isValidId(userId)
                    && isValidId(sessionId)
                    && request.auth.uid == userId
                    && isValidSession(incoming());
                    
      allow update: if isSignedIn()
                    && isValidId(userId)
                    && isValidId(sessionId)
                    && request.auth.uid == userId
                    && isValidSession(incoming())
                    && incoming().userId == existing().userId
                    && incoming().id == existing().id
                    && incoming().timestamp == existing().timestamp;

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId;
    }
  }
}
