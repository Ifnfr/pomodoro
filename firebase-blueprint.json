{
  "entities": {
    "Session": {
      "title": "Focus Session",
      "description": "A completed focus timer session",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID of the session owner"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["pomodoro", "shortBreak", "longBreak"]
        },
        "durationMinutes": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": ["userId", "id", "mode", "durationMinutes", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/Session"
      },
      "description": "Focus sessions for a user"
    }
  }
}
